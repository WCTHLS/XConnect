# Dependencies
node_modules/
.pnpm-store/

# Expo & Metro
.expo/
dist/
coverage/
*.log
*.bundle
*.jsbundle

# Environment variables
.env
.env.*
*.env
!.env.example

# Local Bicep parameter files (hold real connection strings)
infra/*.local.bicepparam

# Build outputs & Release binaries
outputs/
*.apk
*.aab
*.ipa
*.zip

# Android native build artifacts
android/.gradle/
android/app/build/
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/local.properties

# iOS native build artifacts
ios/Pods/
ios/build/
apps/mobile/ios/Pods/
apps/mobile/ios/build/

# Keystores (ignore private keys, allow debug.keystore)
*.keystore
*.jks
!apps/mobile/android/app/debug.keystore

# Apple signing and push keys (APNs auth keys are named AuthKey_<KeyID>.p8)
*.p8
*.p12
*.mobileprovision

# IDE & Local tool configs
.idea/
*.iml
.vscode/
.freebuff/

# Firebase config (per environment, not committed)
google-services.json
