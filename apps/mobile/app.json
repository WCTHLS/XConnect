{
  "expo": {
    "name": "XConnect",
    "slug": "xconnect-poc",
    "scheme": "xconnect",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.xconnect.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.waferwire.xconnect",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSBluetoothAlwaysUsageDescription": "XConnect uses Bluetooth Low Energy to detect in-room peer presence.",
        "NSBluetoothPeripheralUsageDescription": "XConnect broadcasts BLE tokens for zero-hardware presence detection.",
        "NSLocationWhenInUseUsageDescription": "XConnect uses location services to verify in-room Wi-Fi network fingerprints.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "7dd6c543-831d-4c0c-8d12-bbef07b96e6e"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ]
  }
}
