# Copy this file to .env (ignored by git) and fill in the values for the environment you build for.
# These are public identifiers, not secrets: Expo copies EXPO_PUBLIC_* values into the built app.
# Leave a value empty to turn that sign-in method off (an empty client ID hides its button).
# Restart Metro with `npx expo start --clear` after changing .env. Release builds need a new build.

# Firebase (Project settings > General > Web API key)
EXPO_PUBLIC_FIREBASE_API_KEY=

# Google sign-in OAuth client IDs (Google Cloud Console, same project as Firebase)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Microsoft sign-in: the app registration's Application (client) ID
EXPO_PUBLIC_AUTH_CLIENT_ID=

# Microsoft sign-in address. Leave all three empty for the default
# https://login.microsoftonline.com/common/v2.0 (Workforce registration, any Microsoft account).
# For an External ID tenant set the full authority, or the subdomain and tenant ID that build
# https://<subdomain>.ciamlogin.com/<tenant-id>/v2.0
EXPO_PUBLIC_AUTH_AUTHORITY=
EXPO_PUBLIC_AUTH_SUBDOMAIN=
EXPO_PUBLIC_AUTH_TENANT_ID=
