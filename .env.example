# Use the LAN IP of the laptop when testing from physical phones.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
API_PORT=3000

# Optional. Unset = pure in-memory mode (fine for most local dev). Set to enable
# Postgres persistence, e.g. a local Docker instance:
#   docker run --name confpresence-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=confpresence -p 5432:5432 -d postgres:16-alpine
# DATABASE_URL=postgres://postgres:dev@localhost:5432/confpresence
