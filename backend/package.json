{
  "name": "@confpresence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx src/test_wifi_inference.ts && tsx src/test_room_access.ts && tsx src/test_persistence.ts && tsx src/test_trusted_email.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@azure/notification-hubs": "^2.1.0",
    "@confpresence/shared": "workspace:*",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "tsx": "^4.19.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3"
  }
}
